mment><![CDATA[ cam table is absolute for master and slave ]]></Comment></EnumInfo><EnumInfo><Text>MC_STARTMODE_RELATIVE</Text><Enum>2</Enum><Comment><![CDATA[ cam table is relative for master and slave ]]></Comment></EnumInfo><EnumInfo><Text>MC_STARTMODE_MASTERABS_SLAVEREL</Text><Enum>3</Enum><Comment><![CDATA[ cam table is absolute for master and relative for slave ]]></Comment></EnumInfo><EnumInfo><Text>MC_STARTMODE_MASTERREL_SLAVEABS</Text><Enum>4</Enum><Comment><![CDATA[ cam table is relative for master and absolute for slave ]]></Comment></EnumInfo></DataType><DataType><Name Decoration="300003A2" Namespace="Tc2_MC2_Camming">Tc2_MC2_Camming.MC_StartMode</Name><Type>MC_STARTMODE</Type><BitSize>16</BitSize></DataType><DataType><Name Decoration="300005D7">Tc2_MC2_Camming.MC_CamActivationMode</Name><Type>UINT</Type><BitSize>16</BitSize><EnumInfo><Text>MC_CAMACTIVATION_INSTANTANEOUS</Text><Enum>0</Enum><Comment><![CDATA[ instantaneous change ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_ATMASTERCAMPOS</Text><Enum>1</Enum><Comment><![CDATA[ modify the data at a defined master position referring to the cam tables master position ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_ATMASTERAXISPOS</Text><Enum>2</Enum><Comment><![CDATA[ modify the data at a defined master position referring to the absolute master axis position ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_NEXTCYCLE</Text><Enum>3</Enum><Comment><![CDATA[ modify the data at the beginning of the next cam table cycle ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_NEXTCYCLEONCE</Text><Enum>4</Enum><Comment><![CDATA[ not yet implemented! Modify the data at the beginning of the next cam table cycle, activation is valid for one cycle only ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_ASSOONASPOSSIBLE</Text><Enum>5</Enum><Comment><![CDATA[ modify the data as soon as the cam table is in a safe state to change its data ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_OFF</Text><Enum>6</Enum><Comment><![CDATA[ don't accept any modification ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_DELETEQUEUEDDATA</Text><Enum>7</Enum><Comment><![CDATA[ delete all data which was written to modify the cam table but is still not activated ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_ATMASTERAXISPOS_POSITVEDIRECTION</Text><Enum>8</Enum><Comment><![CDATA[ special mode at a defined master axis position in a defined positive direction ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_ATMASTERAXISPOS_NEGATIVEDIRECTION</Text><Enum>9</Enum><Comment><![CDATA[ special mode at a defined master axis position in a defined negative direction ]]></Comment></EnumInfo><EnumInfo><Text>MC_CAMACTIVATION_BUFFERED</Text><Enum>10</Enum><Comment><![CDATA[ multi cam modes 
